{
	"luci-app-screentime": {
		"description": "Grant UCI, ubus, and service access for Screen Time",
		"read": {
			"ubus": {
				"luci-rpc": [
					"getHostHints",
					"getDHCPLeases"
				],
				"service": [
					"list"
				],
				"system": [
					"info"
				]
			},
			"uci": [
				"screentime",
				"system",
				"firewall"
			]
		},
		"write": {
			"uci": [
				"screentime",
				"firewall"
			],
			"ubus": {
				"uci": [
					"add",
					"set",
					"delete",
					"order",
					"rename",
					"apply",
					"confirm",
					"commit",
					"revert"
				],
				"service": [
					"start",
					"stop",
					"restart",
					"reload"
				]
			},
			"file": {
				"/usr/bin/screentime": [
					"exec"
				]
			}
		}
	}
}
