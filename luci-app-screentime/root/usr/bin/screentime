#!/bin/sh
# /usr/bin/screentime
# Backend for luci-app-screentime: managed devices have network access only inside
# scheduled windows. decide.awk is the single source of truth for "allowed now";
# this script applies its answer as an nft set and tears down flows of newly blocked devices.

DECIDE_AWK="${SCREENTIME_DECIDE:-/usr/share/screentime/decide.awk}"
OVERRIDE_FILE="${OVERRIDE_FILE:-/etc/screentime.override}"
STATE_FILE="${STATE_FILE:-/tmp/screentime.blocked}"
LOCK_DIR="${LOCK_DIR:-/tmp/screentime.lock}"
LEASES_FILE="${LEASES_FILE:-/tmp/dhcp.leases}"
TABLE="screentime"
MIN_EPOCH=1700000000	# earlier than this means NTP has not set the clock yet

config_dump() {
	if [ -n "$UCI_CONFIG_DIR" ]; then
		uci -c "$UCI_CONFIG_DIR" -q show screentime
	else
		uci -q show screentime
	fi
}

# Prints "<dow> <seconds since midnight> <epoch>"; SCREENTIME_CLOCK overrides it for tests.
clock() {
	if [ -n "$SCREENTIME_CLOCK" ]; then
		echo "$SCREENTIME_CLOCK"
		return
	fi
	date '+%a %H %M %S %s' | awk '{print tolower($1), $2 * 3600 + $3 * 60 + $4, $5}'
}

# Sets OVR_MODE (none|ignore|forced) and OVR_LEFT; an expired or malformed file is removed.
read_override() {
	OVR_MODE=none
	OVR_LEFT=0
	[ -r "$OVERRIDE_FILE" ] || return 0
	read -r ovr_mode ovr_expiry < "$OVERRIDE_FILE"
	case "$ovr_mode" in
		ignore | forced) ;;
		*) rm -f "$OVERRIDE_FILE"; return 0 ;;
	esac
	case "$ovr_expiry" in
		'' | *[!0-9]*) rm -f "$OVERRIDE_FILE"; return 0 ;;
	esac
	if [ "$ovr_expiry" -gt "$1" ]; then
		OVR_MODE=$ovr_mode
		OVR_LEFT=$((ovr_expiry - $1))
	else
		rm -f "$OVERRIDE_FILE"
	fi
}

load_state() {
	# shellcheck disable=SC2046
	set -- $(clock)
	CLK_DOW=$1
	CLK_SEC=$2
	CLK_EPOCH=$3
	read_override "$CLK_EPOCH"
}

decide() {
	config_dump | awk -v fmt="$1" -v dow="$CLK_DOW" -v sec="$CLK_SEC" -v epoch="$CLK_EPOCH" \
		-v ovr="$OVR_MODE" -v left="$OVR_LEFT" -f "$DECIDE_AWK"
}

lock() {
	tries=0
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		tries=$((tries + 1))
		if [ "$tries" -gt 10 ]; then
			rmdir "$LOCK_DIR" 2>/dev/null	# stale lock from a killed run
			tries=0
		fi
		sleep 1
	done
	trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
}

unlock() {
	rmdir "$LOCK_DIR" 2>/dev/null
	trap - EXIT
}

# MAC -> every known IPv4/IPv6 address, one per line
ips_for_mac() {
	{
		awk -v m="$1" '$2 == m {print $3}' "$LEASES_FILE" 2>/dev/null
		ip neigh 2>/dev/null | awk -v m="$1" '{for (i = 1; i < NF; i++) if ($i == "lladdr" && tolower($(i + 1)) == m) print $1}'
	} | sort -u
}

flush_flows() {
	command -v conntrack >/dev/null 2>&1 || return 0
	for mac in "$@"; do
		for ip in $(ips_for_mac "$mac"); do
			case "$ip" in *:*) fam="-f ipv6" ;; *) fam="-f ipv4" ;; esac
			# shellcheck disable=SC2086
			conntrack $fam -D -s "$ip" >/dev/null 2>&1
			# shellcheck disable=SC2086
			conntrack $fam -D -d "$ip" >/dev/null 2>&1
		done
	done
}

# Atomically replaces our private nft table; fw4 is never touched.
apply_ruleset() {
	elements=$(printf '%s\n' "$1" | awk 'NF {printf "%s%s", sep, $1; sep = ", "}')
	set_elements=""
	[ -n "$elements" ] && set_elements="elements = { $elements }"
	nft -f - <<EOF
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	set blocked {
		type ether_addr
		$set_elements
	}
	chain forward {
		type filter hook forward priority -1; policy accept;
		ether saddr @blocked reject
	}
}
EOF
}

# Blocked MACs in $1 that were not blocked in $2
newly_blocked() {
	{ printf '%s\n@@\n%s\n' "$2" "$1"; } | awk '/^@@$/ {cur = 1; next} !cur {old[$0]; next} $0 != "" && !($0 in old)'
}

reconcile() {
	lock
	load_state
	if [ "$CLK_EPOCH" -ge "$MIN_EPOCH" ]; then
		blocked=$(decide lines | awk -F'|' '$1 == "D" && $3 == 0 {print $2}' | sort)
		prev=$(cat "$STATE_FILE" 2>/dev/null)
		if [ "$blocked" != "$prev" ] || ! nft list table inet "$TABLE" >/dev/null 2>&1; then
			apply_ruleset "$blocked" || { unlock; return 1; }
			printf '%s\n' "$blocked" > "$STATE_FILE"
			# shellcheck disable=SC2046
			flush_flows $(newly_blocked "$blocked" "$prev")
		fi
	fi
	unlock
}

# Override ends at the next change of the global window state: an ignored downtime
# resumes when the next window opens, a forced downtime ends when the window closes.
set_override() {
	load_state
	OVR_MODE=none
	OVR_LEFT=0
	next=$(decide lines | awk -F'|' '$1 == "G" {print $4}')
	[ "${next:--1}" -lt 0 ] && next=86400
	echo "$1 $((CLK_EPOCH + next))" > "$OVERRIDE_FILE"
	reconcile
	cmd_status
}

fmt_duration() {
	[ "$1" -lt 0 ] && { echo "-"; return; }
	echo "$1" | awk '{h = int($1 / 3600); m = int(($1 % 3600) / 60); printf "%dh %02dm", h, m}'
}

cmd_status() {
	load_state
	zone=$(uci -q get system.@system[0].zonename || echo UTC)
	decision=$(decide lines)
	in_window=$(printf '%s\n' "$decision" | awk -F'|' '$1 == "G" {print $3}')
	enabled=$(printf '%s\n' "$decision" | awk -F'|' '$1 == "G" {print $2}')

	echo "Router Clock : $(date '+%Y-%m-%d %I:%M:%S %p') ($zone)"
	if [ "$enabled" = 0 ]; then
		echo "State        : DISABLED (all devices allowed)"
	elif [ "$OVR_MODE" = ignore ]; then
		echo "State        : DOWNTIME IGNORED for $(fmt_duration "$OVR_LEFT")"
	elif [ "$OVR_MODE" = forced ]; then
		echo "State        : DOWNTIME FORCED for $(fmt_duration "$OVR_LEFT")"
	elif [ "$in_window" = 1 ]; then
		echo "State        : INSIDE a scheduled window"
	else
		echo "State        : DOWNTIME (outside scheduled windows)"
	fi
	printf '%-24s %-19s %-9s %s\n' "Device" "MAC" "Status" "Next change"
	while IFS='|' read -r kind mac allowed _ change name; do
		[ "$kind" = D ] || continue
		label=BLOCKED
		[ "$allowed" = 1 ] && label=ALLOWED
		printf '%-24s %-19s %-9s %s\n' "${name:-Device}" "$mac" "$label" "$(fmt_duration "$change")"
	done <<EOF
$decision
EOF
}

mac_valid() {
	echo "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'
}

cmd_add_device() {
	if [ $# -lt 1 ] || [ $# -gt 2 ]; then
		echo 'Usage: screentime add-device ["Device Name"] <MAC_ADDRESS>' >&2
		exit 1
	fi
	if [ $# -eq 1 ]; then name=""; mac=$1; else name=$1; mac=$2; fi
	mac_valid "$mac" || { echo "Error: invalid MAC address '$mac'" >&2; exit 1; }
	mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]')

	sec="dev_$(echo "$mac" | tr -d ':')"
	uci set screentime."$sec"=device
	[ -n "$name" ] && uci set screentime."$sec".name="$name"
	uci set screentime."$sec".mac="$mac"
	uci set screentime."$sec".enabled=1
	uci commit screentime
	reconcile
	cmd_status
}

cmd_remove_device() {
	[ $# -eq 1 ] || { echo "Usage: screentime remove-device <MAC_ADDRESS or Name>" >&2; exit 1; }
	target=$(echo "$1" | tr '[:upper:]' '[:lower:]')
	for sec in $(uci -q show screentime | awk -F'[.=]' '$3 == "device" {print $2}'); do
		mac=$(uci -q get screentime."$sec".mac | tr '[:upper:]' '[:lower:]')
		name=$(uci -q get screentime."$sec".name | tr '[:upper:]' '[:lower:]')
		if [ "$mac" = "$target" ] || [ "$name" = "$target" ]; then
			uci -q delete screentime."$sec"
		fi
	done
	uci commit screentime
	reconcile
	cmd_status
}

cmd_status_json() {
	load_state
	decide json
}

# Remove everything reconcile creates at runtime (the override file is user state; the
# package pre-deinstall script removes it).
cmd_teardown() {
	nft delete table inet "$TABLE" 2>/dev/null
	rm -f "$STATE_FILE"
	rmdir "$LOCK_DIR" 2>/dev/null
}

case "$1" in
	status)           if [ "$2" = "--json" ]; then cmd_status_json; else cmd_status; fi ;;
	reconcile | sync) reconcile ;;
	ignore-downtime)  set_override ignore ;;
	turn-on-downtime) set_override forced ;;
	clear-override)   rm -f "$OVERRIDE_FILE"; reconcile; cmd_status ;;
	add-device)       shift; cmd_add_device "$@" ;;
	remove-device)    shift; cmd_remove_device "$@" ;;
	teardown)         cmd_teardown ;;
	*)
		cat <<EOF
Usage: screentime <command> [arguments]

  status [--json]          Current state and per-device status
  reconcile                Apply the schedule now (also run every minute by cron)
  ignore-downtime          Allow devices until the next window opens
  turn-on-downtime         Block devices until the current window closes
  clear-override           Drop any override and resume the schedule
  add-device [name] <mac>  Manage a device
  remove-device <mac|name> Stop managing a device
  teardown                 Remove the nft table and runtime state
EOF
		;;
esac
