#!/bin/sh /etc/rc.common
# Screen Time: reconcile the schedule every minute and whenever NTP sets the clock.

# shellcheck disable=SC2034
START=95
STOP=10
USE_PROCD=1

CRON_FILE=/etc/crontabs/root

set_cron() {
	mkdir -p /etc/crontabs
	touch "$CRON_FILE"
	sed -i '/screentime/d' "$CRON_FILE"
	[ "$1" = on ] && echo '* * * * * /usr/bin/screentime reconcile >/dev/null 2>&1' >> "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1
}

start_service() {
	set_cron on
	/usr/bin/screentime reconcile
}

stop_service() {
	set_cron off
	/usr/bin/screentime teardown
}

service_triggers() {
	procd_add_reload_trigger screentime
}

reload_service() {
	/usr/bin/screentime reconcile
}
