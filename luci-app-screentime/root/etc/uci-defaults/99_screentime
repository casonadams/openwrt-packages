#!/bin/sh
# Seed the config on first install (it is not a packaged conffile, so upgrades never leave .apk-new).
[ -e /etc/config/screentime ] || cp /usr/share/screentime/default.config /etc/config/screentime

# Drop rules written by releases that used fw4 UCI rules.
legacy=$(uci -q show firewall | awk -F= '$1 ~ /^firewall\.screentime_[^.]*$/ {sub(/^firewall\./, "", $1); print $1}')
if [ -n "$legacy" ]; then
	for sec in $legacy; do
		uci -q delete firewall."$sec"
	done
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
fi
/etc/init.d/screentime enable >/dev/null 2>&1
/etc/init.d/screentime restart >/dev/null 2>&1
exit 0
