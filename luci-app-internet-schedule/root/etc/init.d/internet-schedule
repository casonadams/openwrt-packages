#!/bin/sh /etc/rc.common
# /etc/init.d/internet-schedule
# OpenWrt procd service for Internet Access Scheduler

START=95
STOP=10
USE_PROCD=1

start_service() {
	/usr/bin/internet-schedule sync
}

stop_service() {
	uci -q delete firewall.kids_schedule_allow
	uci -q delete firewall.kids_schedule_block
	uci commit firewall
	fw4 reload >/dev/null 2>&1
	sed -i '/internet-schedule/d' /etc/crontabs/root 2>/dev/null
	/etc/init.d/cron restart >/dev/null 2>&1
}

reload_service() {
	/usr/bin/internet-schedule sync
}

service_triggers() {
	procd_add_reload_trigger "internet_schedule"
}
