#!/bin/sh
# /usr/bin/internet-schedule
# Backend engine for luci-app-internet-schedule
# Implements Apple Screen Time "Ignore Downtime Until Schedule" and "Turn On Downtime Until Schedule"

CRON_FILE="/etc/crontabs/root"
OVERRIDE_FILE="/etc/internet-schedule.override"

parse_time() {
	raw=$(echo "$1" | tr 'A-Z' 'a-z' | tr -d ' ')
	is_pm=0; is_am=0
	case "$raw" in
		*pm) is_pm=1; raw=${raw%pm} ;;
		*am) is_am=1; raw=${raw%am} ;;
	esac
	h=$(echo "$raw" | cut -d: -f1)
	m=$(echo "$raw" | cut -d: -f2 -s)
	s=$(echo "$raw" | cut -d: -f3 -s)
	[ -z "$m" ] && m=0
	[ -z "$s" ] && s=0
	if [ "$is_pm" -eq 1 ] && [ "$h" -lt 12 ]; then
		h=$((h + 12))
	elif [ "$is_am" -eq 1 ] && [ "$h" -eq 12 ]; then
		h=0
	fi
	printf "%02d:%02d:%02d" "$h" "$m" "$s"
}

calc_stop_time() {
	start_time="$1"
	duration="$2"
	[ -z "$duration" ] && duration=90

	h=$(echo "$start_time" | cut -d: -f1 | sed 's/^0//')
	m=$(echo "$start_time" | cut -d: -f2 | sed 's/^0//')
	[ -z "$h" ] && h=0
	[ -z "$m" ] && m=0

	start_tot=$((h * 60 + m))
	stop_tot=$(((start_tot + duration) % 1440))
	stop_h=$((stop_tot / 60))
	stop_m=$((stop_tot % 60))

	printf "%02d:%02d:00" "$stop_h" "$stop_m"
}

init_config() {
	if [ ! -f /etc/config/internet_schedule ]; then
		touch /etc/config/internet_schedule
		uci set internet_schedule.settings=settings
		uci set internet_schedule.settings.enabled='1'
		uci set internet_schedule.schedule_a=schedule
		uci set internet_schedule.schedule_a.enabled='1'
		uci set internet_schedule.schedule_a.start_time='18:00:00'
		uci set internet_schedule.schedule_a.duration='90'
		uci set internet_schedule.schedule_a.stop_time='19:30:00'
		uci add_list internet_schedule.schedule_a.weekdays='all'
		uci commit internet_schedule
	fi
}

get_devices() {
	init_config
	uci show internet_schedule 2>/dev/null | grep -E "=device$" | while read -r line; do
		sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
		dev_enabled=$(uci -q get internet_schedule."$sec".enabled || echo "1")
		[ "$dev_enabled" = "0" ] && continue
		name=$(uci -q get internet_schedule."$sec".name || echo "Unnamed Device")
		mac=$(uci -q get internet_schedule."$sec".mac | tr 'A-F' 'a-f')
		if [ -n "$mac" ] && echo "$mac" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
			echo "$name|$mac"
		fi
	done
}

get_ip_for_mac() {
	target_mac=$(echo "$1" | tr 'A-F' 'a-f')
	ip=$(awk -v mac="$target_mac" '$2 == mac {print $3; exit}' /tmp/dhcp.leases 2>/dev/null)
	if [ -z "$ip" ]; then
		ip=$(ip -4 neigh 2>/dev/null | awk -v mac="$target_mac" '$5 == mac {print $1; exit}')
	fi
	echo "$ip"
}

flush_flows() {
	get_devices | while IFS='|' read -r name mac; do
		ip=$(get_ip_for_mac "$mac")
		if [ -n "$ip" ] && command -v conntrack >/dev/null 2>&1; then
			conntrack -D -s "$ip" >/dev/null 2>&1
			conntrack -D -d "$ip" >/dev/null 2>&1
		fi
	done
}

clean_firewall_rules() {
	uci show firewall 2>/dev/null | grep -E '^firewall\.kids_schedule_' | cut -d. -f2 | cut -d= -f1 | sort -u | while read -r sec; do
		uci -q delete firewall."$sec"
	done
}

get_override_state() {
	if [ -f "$OVERRIDE_FILE" ]; then
		val=$(cat "$OVERRIDE_FILE" 2>/dev/null | tr -d ' \r\n')
		case "$val" in
			ignore_downtime|forced_downtime) echo "$val" ;;
			*) echo "none" ;;
		esac
	else
		echo "none"
	fi
}

# Determine if current moment is inside an allowed schedule window
is_currently_in_window() {
	now_h=$(date +%H | sed 's/^0//'); [ -z "$now_h" ] && now_h=0
	now_m=$(date +%M | sed 's/^0//'); [ -z "$now_m" ] && now_m=0
	now_s=$(date +%S | sed 's/^0//'); [ -z "$now_s" ] && now_s=0
	now_sec=$((now_h * 3600 + now_m * 60 + now_s))
	cur_day=$(date +%a)

	in_window=1 # 1 = false in ash return codes
	uci show internet_schedule 2>/dev/null | grep -E "=schedule$" | while read -r line; do
		sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
		sec_enabled=$(uci -q get internet_schedule."$sec".enabled || echo "1")
		[ "$sec_enabled" = "0" ] && continue

		# Check weekday
		days=$(uci -q get internet_schedule."$sec".weekdays)
		match_day=0
		if [ -z "$days" ] || [ "$days" = "all" ]; then
			match_day=1
		else
			for d in $days; do
				if [ "$d" = "all" ] || [ "$d" = "$cur_day" ]; then
					match_day=1
					break
				fi
			done
		fi
		[ "$match_day" = "0" ] && continue

		start_t=$(uci -q get internet_schedule."$sec".start_time || echo "18:00:00")
		start_t=$(parse_time "$start_t")
		dur=$(uci -q get internet_schedule."$sec".duration || echo "90")
		stop_t=$(calc_stop_time "$start_t" "$dur")

		s_h=$(echo "$start_t" | cut -d: -f1 | sed 's/^0//'); [ -z "$s_h" ] && s_h=0
		s_m=$(echo "$start_t" | cut -d: -f2 | sed 's/^0//'); [ -z "$s_m" ] && s_m=0
		s_sec=$((s_h * 3600 + s_m * 60))

		e_h=$(echo "$stop_t" | cut -d: -f1 | sed 's/^0//'); [ -z "$e_h" ] && e_h=0
		e_m=$(echo "$stop_t" | cut -d: -f2 | sed 's/^0//'); [ -z "$e_m" ] && e_m=0
		e_sec=$((e_h * 3600 + e_m * 60))

		if [ "$now_sec" -ge "$s_sec" ] && [ "$now_sec" -lt "$e_sec" ]; then
			exit 0
		fi
	done
	return $?
}

# Determine the effective current status string
# Returns: "downtime" or "allowed"
get_current_effective_status() {
	override=$(get_override_state)
	if [ "$override" = "ignore_downtime" ]; then
		echo "allowed"
	elif [ "$override" = "forced_downtime" ]; then
		echo "downtime"
	elif is_currently_in_window; then
		echo "allowed"
	else
		echo "downtime"
	fi
}

sync_firewall() {
	init_config
	CFG_ENABLED=$(uci -q get internet_schedule.settings.enabled || echo "1")

	clean_firewall_rules

	dev_count=$(get_devices | wc -l)
	if [ "$dev_count" -eq 0 ] || [ "$CFG_ENABLED" != "1" ]; then
		uci commit firewall
		fw4 reload >/dev/null 2>&1
		update_cron
		return
	fi

	override=$(get_override_state)

	# 1. If "Ignore Downtime Until Schedule" is active:
	# Devices have full internet access (no blocking rules)
	if [ "$override" = "ignore_downtime" ]; then
		uci commit firewall
		fw4 reload >/dev/null 2>&1
		update_cron
		return
	fi

	# 2. If "Turn On Downtime Until Schedule" is active:
	# Force immediate lockdown (block rule active now)
	if [ "$override" = "forced_downtime" ]; then
		uci set firewall.kids_schedule_block=rule
		uci set firewall.kids_schedule_block.name='Kids_Internet_Block'
		uci set firewall.kids_schedule_block.src='lan'
		uci set firewall.kids_schedule_block.dest='wan'
		uci set firewall.kids_schedule_block.target='REJECT'
		get_devices | while IFS='|' read -r dname mac; do
			uci add_list firewall.kids_schedule_block.src_mac="$mac"
		done
		uci commit firewall
		fw4 reload >/dev/null 2>&1
		flush_flows
		update_cron
		return
	fi

	# 3. Normal schedule: ALLOW windows, then default REJECT
	rule_idx=1
	uci show internet_schedule 2>/dev/null | grep -E "=schedule$" | while read -r line; do
		sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
		sec_enabled=$(uci -q get internet_schedule."$sec".enabled || echo "1")
		[ "$sec_enabled" = "0" ] && continue

		start_t=$(uci -q get internet_schedule."$sec".start_time || echo "18:00:00")
		start_t=$(parse_time "$start_t")

		dur=$(uci -q get internet_schedule."$sec".duration)
		if [ -n "$dur" ] && [ "$dur" -gt 0 ] 2>/dev/null; then
			stop_t=$(calc_stop_time "$start_t" "$dur")
			uci set internet_schedule."$sec".stop_time="$stop_t"
		else
			stop_t=$(uci -q get internet_schedule."$sec".stop_time || echo "19:30:00")
			stop_t=$(parse_time "$stop_t")
		fi

		rule_name="kids_schedule_allow_${rule_idx}"
		uci set firewall."$rule_name"=rule
		uci set firewall."$rule_name".name="Kids_Allow_${sec}"
		uci set firewall."$rule_name".src='lan'
		uci set firewall."$rule_name".dest='wan'
		uci set firewall."$rule_name".target='ACCEPT'
		uci set firewall."$rule_name".start_time="$start_t"
		uci set firewall."$rule_name".stop_time="$stop_t"

		days=$(uci -q get internet_schedule."$sec".weekdays)
		if [ -n "$days" ] && [ "$days" != "all" ]; then
			for d in $days; do
				[ "$d" != "all" ] && uci add_list firewall."$rule_name".weekdays="$d"
			done
		fi

		get_devices | while IFS='|' read -r dname mac; do
			uci add_list firewall."$rule_name".src_mac="$mac"
		done

		rule_idx=$((rule_idx + 1))
	done

	# Catch-all block rule
	uci set firewall.kids_schedule_block=rule
	uci set firewall.kids_schedule_block.name='Kids_Internet_Block'
	uci set firewall.kids_schedule_block.src='lan'
	uci set firewall.kids_schedule_block.dest='wan'
	uci set firewall.kids_schedule_block.target='REJECT'
	get_devices | while IFS='|' read -r dname mac; do
		uci add_list firewall.kids_schedule_block.src_mac="$mac"
	done

	uci commit internet_schedule
	uci commit firewall
	fw4 reload >/dev/null 2>&1
	update_cron
}

weekday_to_cron() {
	case "$1" in
		Sun|sun) echo "0" ;;
		Mon|mon) echo "1" ;;
		Tue|tue) echo "2" ;;
		Wed|wed) echo "3" ;;
		Thu|thu) echo "4" ;;
		Fri|fri) echo "5" ;;
		Sat|sat) echo "6" ;;
		*) echo "*" ;;
	esac
}

update_cron() {
	init_config
	CFG_ENABLED=$(uci -q get internet_schedule.settings.enabled || echo "1")

	mkdir -p /etc/crontabs
	touch "$CRON_FILE"
	sed -i '/internet-schedule/d' "$CRON_FILE"

	if [ "$CFG_ENABLED" = "1" ]; then
		uci show internet_schedule 2>/dev/null | grep -E "=schedule$" | while read -r line; do
			sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
			sec_enabled=$(uci -q get internet_schedule."$sec".enabled || echo "1")
			[ "$sec_enabled" = "0" ] && continue

			start_t=$(uci -q get internet_schedule."$sec".start_time || echo "18:00:00")
			start_h=$(echo "$start_t" | cut -d: -f1 | sed 's/^0*//'); [ -z "$start_h" ] && start_h=0
			start_m=$(echo "$start_t" | cut -d: -f2 | sed 's/^0*//'); [ -z "$start_m" ] && start_m=0

			stop_t=$(uci -q get internet_schedule."$sec".stop_time || echo "19:30:00")
			stop_h=$(echo "$stop_t" | cut -d: -f1 | sed 's/^0*//'); [ -z "$stop_h" ] && stop_h=0
			stop_m=$(echo "$stop_t" | cut -d: -f2 | sed 's/^0*//'); [ -z "$stop_m" ] && stop_m=0

			days=$(uci -q get internet_schedule."$sec".weekdays)
			cron_days="*"
			if [ -n "$days" ] && [ "$days" != "all" ]; then
				c_list=""
				for d in $days; do
					cn=$(weekday_to_cron "$d")
					c_list="${c_list}${cn},"
				done
				cron_days=$(echo "$c_list" | sed 's/,$//')
			fi

			# At start time: transition point, resets any active override
			echo "$start_m $start_h * * $cron_days /usr/bin/internet-schedule on-schedule-boundary >/dev/null 2>&1" >> "$CRON_FILE"

			# At stop time: transition point, resets any active override & flushes active flows
			echo "$stop_m $stop_h * * $cron_days /usr/bin/internet-schedule on-schedule-boundary >/dev/null 2>&1" >> "$CRON_FILE"
		done
	fi

	/etc/init.d/cron restart >/dev/null 2>&1
}

# Called automatically when any schedule start or stop time arrives
cmd_on_boundary() {
	if [ -f "$OVERRIDE_FILE" ]; then
		rm -f "$OVERRIDE_FILE"
	fi
	sync_firewall
	if ! is_currently_in_window; then
		flush_flows
	fi
}

cmd_ignore_downtime() {
	echo "ignore_downtime" > "$OVERRIDE_FILE"
	sync_firewall
	echo "Ignore Downtime Until Schedule engaged."
	cmd_status
}

cmd_turn_on_downtime() {
	echo "forced_downtime" > "$OVERRIDE_FILE"
	sync_firewall
	flush_flows
	echo "Turn On Downtime Until Schedule engaged."
	cmd_status
}

cmd_clear_override() {
	rm -f "$OVERRIDE_FILE"
	sync_firewall
	if ! is_currently_in_window; then
		flush_flows
	fi
	echo "Override cleared. Reverted to normal schedule."
	cmd_status
}

cmd_get_state() {
	override=$(get_override_state)
	status=$(get_current_effective_status)
	echo "$status|$override"
}

cmd_status() {
	init_config
	zonename=$(uci -q get system.@system[0].zonename || echo "UTC")
	CFG_ENABLED=$(uci -q get internet_schedule.settings.enabled || echo "1")
	override=$(get_override_state)
	eff_status=$(get_current_effective_status)

	echo "=========================================================="
	echo "              OpenWrt Internet Access Status              "
	echo "=========================================================="
	echo "Router Clock   : $(date '+%Y-%m-%d %I:%M:%S %p') ($zonename)"

	echo -n "Current State  : "
	if [ "$eff_status" = "downtime" ]; then
		if [ "$override" = "forced_downtime" ]; then
			echo "DOWNTIME (Turned On Until Next Schedule)"
		else
			echo "DOWNTIME (Outside Scheduled Hours)"
		fi
	else
		if [ "$override" = "ignore_downtime" ]; then
			echo "INTERNET ALLOWED (Downtime Ignored Until Next Schedule)"
		else
			echo "INTERNET ALLOWED (Inside Scheduled Hours)"
		fi
	fi
	echo "----------------------------------------------------------"
	echo "Configured Schedules:"
	uci show internet_schedule 2>/dev/null | grep -E "=schedule$" | while read -r line; do
		sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
		sec_enabled=$(uci -q get internet_schedule."$sec".enabled || echo "1")
		start_t=$(uci -q get internet_schedule."$sec".start_time || echo "18:00:00")
		stop_t=$(uci -q get internet_schedule."$sec".stop_time || echo "19:30:00")
		dur=$(uci -q get internet_schedule."$sec".duration || echo "?")
		days=$(uci -q get internet_schedule."$sec".weekdays || echo "all")
		st_str="ENABLED"
		[ "$sec_enabled" = "0" ] && st_str="DISABLED"
		printf "  [%s] %s -> %s (%s min) Days: %s\n" "$st_str" "$start_t" "$stop_t" "$dur" "$days"
	done

	echo "----------------------------------------------------------"
	printf "%-24s %-19s %-16s %-10s\n" "Device Name" "MAC Address" "IP Address" "Status"
	printf "%-24s %-19s %-16s %-10s\n" "------------------------" "-------------------" "----------------" "---------"

	get_devices | while IFS='|' read -r name mac; do
		ip=$(get_ip_for_mac "$mac")
		[ -z "$ip" ] && ip="(offline)"

		status="BLOCKED"
		if [ "$eff_status" = "allowed" ]; then
			status="ALLOWED"
		fi
		printf "%-24s %-19s %-16s %-10s\n" "$name" "$mac" "$ip" "$status"
	done
	echo "=========================================================="
}

cmd_add_device() {
	if [ -z "$1" ] || [ -z "$2" ]; then
		echo "Usage: internet-schedule add-device \"Device Name\" <MAC_ADDRESS>"
		exit 1
	fi
	name="$1"
	mac=$(echo "$2" | tr 'A-F' 'a-f')
	if ! echo "$mac" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
		echo "Error: Invalid MAC address format: '$mac'"
		exit 1
	fi

	init_config
	sec=$(echo "dev_${mac}" | tr -d ':')
	uci set internet_schedule."$sec"=device
	uci set internet_schedule."$sec".name="$name"
	uci set internet_schedule."$sec".mac="$mac"
	uci set internet_schedule."$sec".enabled='1'
	uci commit internet_schedule

	sync_firewall
	echo "Added '$name' ($mac)."
	cmd_status
}

cmd_remove_device() {
	if [ -z "$1" ]; then
		echo "Usage: internet-schedule remove-device <MAC_ADDRESS or Name>"
		exit 1
	fi
	target=$(echo "$1" | tr 'A-F' 'a-f')

	uci show internet_schedule 2>/dev/null | grep -E "=device$" | while read -r line; do
		sec=$(echo "$line" | cut -d. -f2 | cut -d= -f1)
		name=$(uci -q get internet_schedule."$sec".name || echo "Unnamed Device")
		mac=$(uci -q get internet_schedule."$sec".mac | tr 'A-F' 'a-f')
		if [ "$mac" = "$target" ] || [ "$name" = "$target" ]; then
			uci -q delete internet_schedule."$sec"
			uci commit internet_schedule
		fi
	done

	sync_firewall
	cmd_status
}

case "$1" in
	status)                   cmd_status ;;
	ignore-downtime)          cmd_ignore_downtime ;;
	turn-on-downtime)         cmd_turn_on_downtime ;;
	clear-override)           cmd_clear_override ;;
	on-schedule-boundary)     cmd_on_boundary ;;
	get-state)                cmd_get_state ;;
	add-device)               shift; cmd_add_device "$@" ;;
	remove-device)            shift; cmd_remove_device "$@" ;;
	sync)                     sync_firewall ;;
	flush-flows)              flush_flows ;;
	*)
		echo "Usage: internet-schedule <command> [arguments]"
		echo ""
		echo "Commands:"
		echo "  status                  Show current status, clock, and override state"
		echo "  ignore-downtime         Ignore downtime until the next scheduled boundary"
		echo "  turn-on-downtime        Turn on downtime immediately until the next schedule"
		echo "  clear-override          Clear active override and resume normal schedule"
		echo "  get-state               Machine-readable current state (status|override)"
		echo "  add-device <name> <mac> Add a target device"
		echo "  remove-device <name>    Remove a target device"
		echo "  sync                    Sync firewall rules with configuration"
		;;
esac
