config settings 'settings'
	option enabled '0'
	option domain ''
	option duckdns_token ''
	option email ''
	option staging '0'
	option dot_port '853'
	option allow_failover '0'
	option ratelimit '500'
	option blocklist 'hagezi'
	list fallback 'https://doh.cleanbrowsing.org/doh/family-filter/'
	list fallback '185.228.168.168'

config profile 'kids'
	option name 'Kids'
	list upstream 'https://doh.cleanbrowsing.org/doh/family-filter/'

config profile 'adult'
	option name 'Adult'
	list upstream 'https://doh.cleanbrowsing.org/doh/adult-filter/'

config device 'everyone'
	option name 'Everyone else'
	option profile 'kids'
