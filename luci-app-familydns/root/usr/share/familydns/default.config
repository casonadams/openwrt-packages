config settings 'settings'
	option enabled '0'
	option domain ''
	option duckdns_token ''
	option email ''
	option staging '0'
	option dot_port '853'
	option web_port '3001'
	list fallback 'https://doh.cleanbrowsing.org/doh/family-filter/'
	list fallback '185.228.168.168'

config profile 'kids'
	option name 'Kids'
	option filtering '1'
	option safe_search '1'
	option parental '1'
	option safebrowsing '1'
	list upstream 'https://doh.cleanbrowsing.org/doh/family-filter/'

config profile 'adult'
	option name 'Adult'
	option filtering '1'
	option safe_search '0'
	option parental '0'
	option safebrowsing '0'
	list upstream 'https://doh.cleanbrowsing.org/doh/security-filter/'
